`verilator_config

lint_off -rule DECLFILENAME -file "*/fir_accelerator/rtl/fir_accelerator_reg_top.sv" -match "*fir_accelerator_reg_top_intf*"

lint_off -rule WIDTHTRUNC -file "*/fir_accelerator/rtl/fir_accelerator_reg_top.sv" -match "*reg_addr*"

lint_off -rule UNUSEDSIGNAL -file "*/fir_accelerator/rtl/fir_accelerator.sv" -match "*reg2hw*"
lint_off -rule UNUSEDSIGNAL -file "*/fir_accelerator/rtl/mac.sv" -match "*accumulatorScaled*"
